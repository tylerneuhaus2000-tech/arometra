# Copy to .env.local. This explicit local mode uses only synthetic test fixtures.
AROMETRA_DATA_MODE=fixtures

# Set AROMETRA_DATA_MODE=supabase to use a dedicated development Supabase project.
# The public catalog uses a publishable key and database RLS. Never use a secret/service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional private catalog-import CLI configuration; values stay in ignored .env.local.
# Mutating import commands accept only an explicitly selected local or dedicated development project.
AROMETRA_SUPABASE_TARGET=
AROMETRA_DEVELOPMENT_PROJECT_REF=
SUPABASE_IMPORT_ACCESS_TOKEN=

# Optional live API security test: use a short-lived authenticated test-user token without an admin role.
SUPABASE_INTEGRATION_NON_ADMIN_ACCESS_TOKEN=
# Use a separate short-lived owner/editor token for the positive administrative permission probe.
SUPABASE_INTEGRATION_ADMIN_ACCESS_TOKEN=
