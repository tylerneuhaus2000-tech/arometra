{
  "name": "arometra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "ui-preview": "node scripts/start-ui-preview.mjs",
    "build": "next build",
    "start": "next start",
    "pages:config": "node scripts/write-pages-config.mjs",
    "lint": "biome lint src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:dry-run": "tsx scripts/import-catalog.ts dry-run",
    "import:adapt-start-database": "tsx scripts/adapt-start-database.ts",
    "import:register-sources": "tsx scripts/import-catalog.ts register-sources",
    "import:stage": "tsx scripts/import-catalog.ts stage",
    "import:upsert": "tsx scripts/import-catalog.ts upsert",
    "import:review-rights": "tsx scripts/import-catalog.ts review-rights",
    "import:attest-data": "tsx scripts/import-catalog.ts attest-data",
    "import:publish": "tsx scripts/import-catalog.ts publish",
    "supabase:integration-tokens": "tsx scripts/set-supabase-integration-tokens.ts",
    "test:integration:supabase": "tsx scripts/test-supabase-integration.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset:local": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.8",
    "@next/env": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
